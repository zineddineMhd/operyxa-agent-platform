# Copy to .env. Never commit real secrets.
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://operyxa:operyxa@localhost:5432/operyxa
JWT_SECRET_KEY=replace_me_with_a_long_random_value
CORS_ORIGINS=["http://localhost:5173"]

# Encrypts per-project GitHub tokens (private repositories). Any long random string.
SECRETS_KEY=

# LLM provider:
#   demo               deterministic offline model (no key, no cost)
#   gemini             Google Gemini API
#   openai_compatible  NVIDIA NIM (default base URL) or any OpenAI-style API with tool calling
LLM_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used when the main model stays overloaded after retries.
GEMINI_FALLBACK_MODEL=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Tool calling verified on NVIDIA: nvidia/nemotron-3-ultra-550b-a55b,
# nvidia/nemotron-3.5-lightning-30b-a3b, minimaxai/minimax-m3.1-flash
LLM_MODEL=
LLM_FALLBACK_MODEL=
# USD per 1M tokens, kept out of the code because prices change.
# LLM_PRICING={"gemini-3.8-flash": {"input": 0.0, "output": 0.0}}

# Per-run budgets (enforced server-side)
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=40
MAX_RUN_SECONDS=600
MAX_RUN_COST_USD=2.00

# Known-vulnerability lookup (osv.dev). Only package names and versions are sent.
# Leave empty to disable.
OSV_API_URL=https://api.osv.dev

# GitHub (read-only). Server-wide token, used when a project has no token of its own.
GITHUB_TOKEN=
# MCP servers: empty = in-process. Set a URL to use a standalone server
# (python -m operyxa.mcp_servers github 8101).
MCP_GITHUB_URL=
MCP_ANALYSIS_URL=

# Sandboxed test execution (F-07). Needs a Docker daemon where the test runner runs, and is
# required on both the API and the worker. Every test run waits for a human approval.
TEST_RUNNER_ENABLED=false
TEST_RUNNER_TIMEOUT_SECONDS=300
TEST_RUNNER_INSTALL_TIMEOUT_SECONDS=300
# Dependency installation may reach package registries; tests never have network.
# false = installation offline too (use images with dependencies baked in).
TEST_RUNNER_INSTALL_NETWORK=true
TEST_RUNNER_MEMORY_MB=1024
TEST_RUNNER_CPUS=1
TEST_RUNNER_MAX_CONCURRENT=1
TEST_RUNNER_MAX_ARCHIVE_MB=50
# Stronger isolation if installed on the Docker host, e.g. runsc (gVisor).
TEST_RUNNER_DOCKER_RUNTIME=
# Replace a profile's image: {"python-pytest": "registry.local/python-test:3.12"}
# TEST_RUNNER_IMAGES={}
# Empty = in-process (the worker needs Docker). Recommended: a dedicated host running
# python -m operyxa.mcp_servers test_runner 8103, reachable only from the worker.
MCP_TEST_RUNNER_URL=
MCP_CHANGES_URL=
# Fix proposals and pull requests created after a human confirmation (F-12).
PULL_REQUESTS_ENABLED=true
