# =====================================================================================
#  Configuration d'Operyxa
#  Copier ce fichier en ".env" (les scripts start.ps1 / start.sh le font pour vous)
#  puis remplir la partie 2. Ne jamais publier le fichier .env : il contient vos clés.
#  Il est déjà ignoré par git (.gitignore).
# =====================================================================================

# -------------------------------------------------------------------------------------
# 1. Sécurité (OBLIGATOIRE). Les scripts de démarrage génèrent ces deux valeurs.
#    Pour les générer à la main :  python -c "import secrets; print(secrets.token_urlsafe(48))"
# -------------------------------------------------------------------------------------
# Signe les sessions de connexion. Au moins 32 caractères. Hors "local", l'API et le
# worker refusent de démarrer si cette valeur est restée celle d'exemple.
JWT_SECRET_KEY=replace_me_with_a_long_random_value
# Chiffre les jetons GitHub des projets (dépôts privés). Vide = dépôts privés désactivés.
SECRETS_KEY=

# local = votre ordinateur ; production = serveur en ligne (contrôles de sécurité stricts)
ENVIRONMENT=local

# -------------------------------------------------------------------------------------
# 2. Modèle d'IA (À REMPLIR pour une vraie analyse)
#    demo              modèle hors-ligne, sans clé : sert à essayer l'interface, ne trouve rien
#    openai_compatible NVIDIA NIM (recommandé) ou tout service compatible OpenAI
#    gemini            Google Gemini
#    Le fournisseur qui n'est pas choisi ici sert de secours si sa clé est remplie.
# -------------------------------------------------------------------------------------
LLM_PROVIDER=demo

# NVIDIA : créer une clé sur https://build.nvidia.com (elle commence par "nvapi-").
# Une clé déjà publiée quelque part doit être révoquée, puis remplacée par une neuve.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Modèles dont l'appel d'outils a été vérifié : nvidia/nemotron-3-ultra-550b-a55b,
# nvidia/nemotron-3.5-lightning-30b-a3b, minimaxai/minimax-m3.1-flash
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Utilisé si le modèle principal reste indisponible.
LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Gemini = SECOURS AUTOMATIQUE. Il suffit de remplir GEMINI_API_KEY (clé gratuite sur
# https://aistudio.google.com/apikey). Si les modèles NVIDIA échouent (surcharge, quota,
# clé refusée), la plateforme bascule toute seule sur Gemini, même au milieu d'une analyse.
# Laisser vide = pas de secours. Inversement, avec LLM_PROVIDER=gemini, NVIDIA sert de secours.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
# Palier gratuit de Gemini : 5 requêtes par minute (environ 20 par jour).
GEMINI_REQUESTS_PER_MINUTE=5
# false = ne jamais changer de fournisseur.
LLM_CROSS_PROVIDER_FALLBACK=true
# Limite pour les modèles NVIDIA (0 = sans limite).
# LLM_REQUESTS_PER_MINUTE=0

# Prix en dollars par million de jetons, pour le suivi des coûts (facultatif).
# LLM_PRICING={"gemini-3.8-flash": {"input": 0.0, "output": 0.0}}

# -------------------------------------------------------------------------------------
# 3. GitHub (RECOMMANDÉ)
#    Jeton en lecture seule pour lire les dépôts publics sans la limite de 60 requêtes
#    par heure. Créer sur https://github.com/settings/personal-access-tokens
#    (droits : Contents et Metadata en lecture). Les dépôts privés utilisent plutôt
#    le jeton saisi dans chaque projet.
# -------------------------------------------------------------------------------------
GITHUB_TOKEN=

# Propositions de correction et pull requests, créées seulement après votre confirmation.
# Elles demandent un jeton d'écriture distinct, saisi dans le projet.
PULL_REQUESTS_ENABLED=true

# -------------------------------------------------------------------------------------
# 4. Réglages avancés (les valeurs par défaut conviennent)
# -------------------------------------------------------------------------------------
# Base de données. Avec Docker (start.ps1 / start.sh), cette ligne est ignorée.
DATABASE_URL=postgresql+psycopg://operyxa:operyxa@localhost:5432/operyxa
# Adresses autorisées à appeler l'API depuis un navigateur (mode développement).
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Limites de chaque run (appliquées par le serveur)
MAX_AGENT_STEPS=20
MAX_TOOL_CALLS=40
MAX_RUN_SECONDS=600
MAX_RUN_COST_USD=2.00

# Tentatives de connexion et d'inscription par minute (0 = sans limite)
AUTH_RATE_LIMIT_PER_MINUTE=10

# Recherche de vulnérabilités connues (osv.dev). Seuls les noms et versions des paquets
# sont envoyés. Vide = désactivé.
OSV_API_URL=https://api.osv.dev

# Serveurs MCP séparés. Vide = dans le même processus (cas normal).
MCP_GITHUB_URL=
MCP_ANALYSIS_URL=
MCP_TEST_RUNNER_URL=
MCP_CHANGES_URL=

# Exécution des tests du dépôt dans un conteneur isolé (F-07). Demande un démon Docker
# accessible par le worker, et chaque exécution attend votre approbation.
# Laisser à false avec start.ps1 / start.sh.
TEST_RUNNER_ENABLED=false
TEST_RUNNER_TIMEOUT_SECONDS=300
TEST_RUNNER_INSTALL_TIMEOUT_SECONDS=300
TEST_RUNNER_INSTALL_NETWORK=true
TEST_RUNNER_MEMORY_MB=1024
TEST_RUNNER_CPUS=1
TEST_RUNNER_MAX_CONCURRENT=1
TEST_RUNNER_MAX_ARCHIVE_MB=50
TEST_RUNNER_DOCKER_RUNTIME=
# TEST_RUNNER_IMAGES={}
